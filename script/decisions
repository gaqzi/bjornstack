#!/usr/bin/env python3
"""Render docs/decisions.md from the decision beads.

A repo may add script/local/decisions.py. It may set DECISIONS_OUT, the path
to write the index to instead of docs/decisions.md (a string or a path; an
absolute path, one with a ".." component, or anything else truthy is refused),
and define
decisions_after(path), called last with that path once the index is written.
Its return value is the exit code; None exits 0.
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import types

INDEX_HEAD = """\
# Decisions

Generated by `script/decisions` from the decision beads. To change it,
change the bead and rerun the script. How decisions are made and recorded:
`.beads/PRIME.md`.

| Bead | Decision | Areas |
|---|---|---|
"""


EXCERPT_LIMIT = 200


class NotBeadRecords(Exception):
    def __init__(self, line_number, line, reason=""):
        super().__init__(line_number, line, reason)
        self.line_number = line_number
        self.excerpt = line[:EXCERPT_LIMIT]
        self.reason = reason


class NotUtf8(Exception):
    pass


def parse_bulk_read(answer):
    records = []
    # Split on "\n" only: bd export writes U+0085 raw inside JSON strings.
    for line_number, line in enumerate(answer.split("\n"), start=1):
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except ValueError:
            raise NotBeadRecords(line_number, line)
        if not isinstance(record, dict) or not isinstance(record.get("id"), str):
            raise NotBeadRecords(line_number, line)
        if "title" in record and not isinstance(record["title"], str):
            raise NotBeadRecords(line_number, line, "title is not a string: ")
        records.append(record)
    return records


def answer_text(stdout):
    # Decode the bytes ourselves: text=True would turn "\r\n" into "\n".
    try:
        return stdout.decode("utf-8")
    except UnicodeDecodeError as err:
        raise NotUtf8() from err


def failure_line(script_name, code, stderr):
    line = f"{script_name}: bd export failed with exit code {code}"
    text = one_line(stderr.decode("utf-8", errors="replace").strip())[:EXCERPT_LIMIT]
    return f"{line}: {text}" if text.strip() else line


def decisions_of(records):
    return [r for r in records if r.get("issue_type") == "decision"]


STATES = ("Accepted", "To decide", "Superseded or withdrawn")


def area_labels(decision):
    labels = decision.get("labels") or []
    return [l[len("area:") :] for l in labels if l.startswith("area:")]


def areas_of(decision):
    return ", ".join(sorted(area_labels(decision)))


def superseded_by(decision):
    return [
        d["depends_on_id"]
        for d in decision.get("dependencies") or []
        if d.get("type") == "supersedes"
    ]


def state_of(decision):
    if decision.get("status") != "closed":
        return "To decide"
    if decision.get("close_reason") == "accepted" and not superseded_by(decision):
        return "Accepted"
    return "Superseded or withdrawn"


ONE_LINE_CONTROLS = re.compile("[\x00-\x1f\x7f-\x9f\u2028\u2029]")
PROSE_CONTROLS = re.compile("[\x00-\x09\x0b-\x1f\x7f-\x9f\u2028\u2029]")
# What can open a block at the start of a line (after up to 3 spaces): an ATX
# heading, a setext underline (= or -), a ``` or ~~~ fence, a quote, a link
# reference or footnote definition ("["), or a - * + bullet.
# Unlike the bash script, which demotes a heading to "####", the marker is
# backslash-escaped, so "## Forged" in a description shows as written.
BLOCK_OPENER = re.compile(
    r"^ {0,3}(#{1,6}([ \t]|$)|(=+|-+)[ \t]*$|[`~]{3,}|>|\[|[-*+]([ \t]|$))"
)
# A numbered item ("1." or "1)"). It takes its own path because the backslash
# goes after the digits ("1\."), where a leading one ("\1.") would show.
LIST_NUMBER = re.compile(r"^ {0,3}([0-9]+)([.)])")


def flat(text):
    """One line of text that opens no tag: controls become spaces, "<" an entity."""
    return ONE_LINE_CONTROLS.sub(" ", str(text)).replace("<", "&lt;")


def one_line(text):
    """One line of text for stderr: controls become spaces."""
    return ONE_LINE_CONTROLS.sub(" ", str(text))


def cell(text):
    """One line of text that stays inside a table cell."""
    return flat(text).replace("\\", "\\\\").replace("|", "\\|")


def escape_line(line):
    """Backslash-escape the block opener a line starts with; "<" becomes an entity."""
    if BLOCK_OPENER.match(line):
        line = "\\" + line.lstrip(" ")
    else:
        line = LIST_NUMBER.sub(r"\1\\\2", line)
    return line.replace("<", "&lt;")


def prose(text):
    """Free text that keeps its newlines but opens no block that outlives it."""
    lines = PROSE_CONTROLS.sub("", str(text)).split("\n")
    return "\n".join(escape_line(line) for line in lines).strip("\n")


def render_row(decision):
    return (
        f"| {cell(decision['id'])} | {cell(decision['title'])}"
        f" | {cell(areas_of(decision))} |\n"
    )


def render_entry(decision):
    closed = ""
    if state_of(decision) == "Superseded or withdrawn":
        closed = f"  \nClosed: {flat(decision.get('close_reason') or '')}"
        replaced_by = superseded_by(decision)
        if replaced_by:
            closed += f"  \nSuperseded by: {', '.join(flat(i) for i in replaced_by)}"
    how_decided = ""
    if decision.get("notes"):
        how_decided = f"\n\n#### How it was decided\n\n{prose(decision['notes'])}"
    return (
        f"### {flat(decision['id'])}: {flat(decision['title'])}\n\nAreas: {flat(areas_of(decision))}"
        f"{closed}\n\n{prose(decision.get('description') or '')}{how_decided}\n"
    )


def render_section(state, decisions):
    return f"## {state}\n" + "".join(
        "\n" + render_entry(d) for d in decisions if state_of(d) == state
    )


def render_index(decisions):
    ordered = sorted(decisions, key=lambda d: (d.get("created_at") or "", d["id"]))
    return (
        INDEX_HEAD
        + "".join(render_row(d) for d in ordered)
        + "\n"
        + "\n".join(render_section(s, ordered) for s in STATES)
    )


AREA_NAME = re.compile(r"[a-z0-9][a-z0-9_-]*")


class NotAreasFile(Exception):
    pass


def listed_areas(areas_text):
    try:
        parsed = json.loads(areas_text)
    except (ValueError, RecursionError) as err:
        raise NotAreasFile(f"not JSON: {err}") from err
    if not isinstance(parsed, dict) or not isinstance(parsed.get("areas"), dict):
        raise NotAreasFile(
            f'expected an object with an "areas" object, got {areas_text[:80]!r}'
        )
    return sorted(k for k in parsed["areas"] if AREA_NAME.fullmatch(k))


def area_problems(decisions, listed):
    problems = []
    for decision in decisions:
        labels = area_labels(decision)
        if not labels:
            problems.append(f"{decision['id']}: no valid area label")
        problems += [
            f"{decision['id']}: unknown area label area:{label}"
            for label in labels
            if label not in listed
        ]
    return problems


def area_refusal(problems, listed):
    return "".join(f"{p}\n" for p in problems) + (
        f"fix the area labels (areas: {', '.join(listed)}), then rerun script/decisions\n"
    )


def read_records():
    try:
        done = subprocess.run(["bd", "export"], capture_output=True, check=False)
    except OSError as err:
        sys.exit(f"script/decisions: cannot run bd: {err}")
    if done.returncode != 0:
        sys.exit(failure_line("script/decisions", done.returncode, done.stderr))
    try:
        return parse_bulk_read(answer_text(done.stdout))
    except NotUtf8:
        sys.exit("script/decisions: bd output is not UTF-8")
    except NotBeadRecords as err:
        sys.exit(
            f"script/decisions: bd did not return bead records: line {err.line_number}: {err.reason}{one_line(err.excerpt)}"
        )


def read_areas():
    path = os.path.join(".beads", "workflow-project-areas.json")
    try:
        try:
            with open(path, encoding="utf-8") as areas_file:
                areas_text = areas_file.read()
        except (OSError, UnicodeDecodeError) as err:
            raise NotAreasFile(str(err)) from err
        return listed_areas(areas_text)
    except NotAreasFile as err:
        sys.exit(f"script/decisions: cannot read the areas from {path}\n{err}")


DEFAULT_OUT = os.path.join("docs", "decisions.md")
LOCAL_PATH = os.path.join("script", "local", "decisions.py")


def output_path(local):
    out = getattr(local, "DECISIONS_OUT", None)
    if not out:
        return DEFAULT_OUT
    if isinstance(out, os.PathLike):
        return os.fspath(out)
    return out


def exit_code_of(returned):
    return 0 if returned is None else returned


def directories_above(path):
    parent = os.path.dirname(path)
    while parent and os.path.dirname(parent) != parent:
        yield parent
        parent = os.path.dirname(parent)


def output_refusal(out):
    if not isinstance(out, str):
        return f"script/decisions: DECISIONS_OUT is not a path: {one_line(repr(out))}"
    if os.path.isabs(out) or ".." in out.split(os.sep):
        return f"script/decisions: {one_line(out)} is outside the repo; refusing to write there"
    parent = os.path.dirname(out)
    if os.path.islink(out) or os.path.islink(parent):
        return f"script/decisions: {parent} or {out} is a symlink; refusing to write through it"
    for directory in directories_above(out):
        if os.path.islink(directory):
            return f"script/decisions: {directory} is a symlink; refusing to write through it"
    if os.path.exists(out) and not os.path.isfile(out):
        return f"script/decisions: {out} exists and is not a regular file; refusing to replace it"
    return None


def write_index(text, out):
    directory = os.path.dirname(out) or "."
    os.makedirs(directory, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix=".decisions.", dir=directory)
    try:
        with os.fdopen(fd, "w") as index_file:
            index_file.write(text)
        os.chmod(temp, 0o644)
        os.replace(temp, out)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def load_local_module():
    if not os.path.isfile(LOCAL_PATH):
        return None
    with open(LOCAL_PATH, encoding="utf-8") as local_file:
        source = local_file.read()
    module = types.ModuleType("decisions_local")
    module.__file__ = LOCAL_PATH
    # A module that fails to import is not handled: its exception ends the run with a traceback.
    exec(compile(source, LOCAL_PATH, "exec"), module.__dict__)  # noqa: S102 - deliberate: runs the repo's script/local hook
    return module


def main():
    os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    local = load_local_module()
    out = output_path(local)
    refusal = output_refusal(out)
    if refusal:
        sys.stderr.write(refusal + "\n")
        sys.exit(1)
    listed = read_areas()
    decisions = decisions_of(read_records())
    problems = area_problems(decisions, listed)
    if problems:
        sys.stderr.write(area_refusal(problems, listed))
        sys.exit(1)
    write_index(render_index(decisions), out)
    print(f"wrote {out}")
    after = getattr(local, "decisions_after", None)
    if callable(after):
        code = exit_code_of(after(out))
        if code:
            sys.exit(code)


if __name__ == "__main__":
    main()
